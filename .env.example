# ============================================================================
# Karaokê Map — variáveis de ambiente (exemplo)
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Painel > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave pública (anon/publishable). Pode ir para o front.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# ATENÇÃO: a service_role key NUNCA deve ser exposta no front.
# Use somente em scripts de admin/CI. Deixe vazio no ambiente do cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapas / Geocoding ------------------------------------------------------
# MapTiler (tiles + geocoding). Free tier.
VITE_MAPTILER_KEY=your-maptiler-key-here

# --- Geocoding alternativo (opcional, fallback) -----------------------------
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- App --------------------------------------------------------------------
VITE_DEFAULT_LOCALE=pt
VITE_DEFAULT_LAT=-3.7319        # Fortaleza (fallback)
VITE_DEFAULT_LNG=-38.5267
VITE_DEFAULT_ZOOM=10

# --- LGPD / contato ---------------------------------------------------------
VITE_LGPD_EMAIL=[email do dev]
