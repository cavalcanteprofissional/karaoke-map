# ============================================================================
# Karaokê Map — variáveis de ambiente (exemplo)
# Copie para `.env.local` e preencha. NUNCA commite o `.env.local` real.
#
# Next.js: variáveis com prefixo NEXT_PUBLIC_ são expostas ao navegador.
# Variáveis SEM prefixo existem apenas no servidor (segredos).
# ============================================================================

# --- Supabase (cliente / navegador) ----------------------------------------
# Painel > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (servidor/scripts — NUNCA expor no cliente) -------------------
# Usada apenas em scripts de admin/seed/CI.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão Postgres direta, usada para aplicar migrations (npm run db:migrate).
# Project Settings > Database > Connection string (Session pooler).
# Formato: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Mapas / Geocoding (MapTiler) ------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key-here
NEXT_PUBLIC_MAP_STYLE=streets-v2-dark

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_DEFAULT_LAT=-3.7319
NEXT_PUBLIC_DEFAULT_LNG=-38.5267
NEXT_PUBLIC_DEFAULT_ZOOM=11

# --- LGPD / contato ---------------------------------------------------------
NEXT_PUBLIC_LGPD_EMAIL=lgpd@example.com
